# PostgreSQL Database Connection
DATABASE_URL=
MIGRATION_DATABASE_URL=
POSTGRES_PASSWORD=

# Security and JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
